<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.MainCounterPage"
             x:Name="Page"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="16">

            <Label
                Text="Liczniki"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Entry Text="{Binding InputName}"
                       Placeholder="Nazwa licznika"
                       ReturnType="Done" />
                <Button Grid.Column="1"
                        Text="Dodaj"
                        Command="{Binding AddCommand}" />
            </Grid>

            <CollectionView ItemsSource="{Binding Counters}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label 
                        Text="Brak liczników. Dodaj nowy powyżej."
                        HorizontalOptions="Center"
                        Margin="0,20,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8"
                              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding CounterName}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding CurrentValue}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="-"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.DecreaseCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="3"
                                    Text="+"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.IncreaseCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="4"
                                    Text="Usuń"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

